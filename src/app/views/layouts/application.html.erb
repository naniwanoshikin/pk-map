<!DOCTYPE html>
<html lang="ja">
  <head>
    <%# (helper) %>
    <title><%= full_title(yield(:title)) %></title>
    <%= render 'layouts/head_tags' %>
  </head>
  <body>
    <%= render 'layouts/header' %>
    <div class="container">
      <div id="flash_messages" class="fixed-top mx-auto">
        <%= render 'layouts/flash' %>
      </div>
      <main>
        <%= yield %>
        <% if Rails.env.development? %>
          <%# 投稿失敗時のデバッグの余計な文字群も考慮 %>
          <code class="debug_dump d-block mt-4 p-2 border border-3 border-secondary rounded"><%= params.inspect.gsub("#<ActionController::Parameters ", "").gsub("permitted: false>", "") %></code>
        <% end %>
      </main>
      <%= render 'layouts/footer' %>
    </div>
  </body>
</html>
