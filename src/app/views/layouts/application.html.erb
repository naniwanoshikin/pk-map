<!DOCTYPE html>
<html>
  <head>
    <%# (helper) %>
    <title><%= full_title(yield(:title)) %></title>
    <%= render 'layouts/head_tags' %>
  </head>
  <body class="drawer drawer--right drawer--navbarTopGutter">
    <%= render 'layouts/header' %>
    <div class="container">
      <%# id: (review/_ajax) %>
      <div id="flash_messages">
        <%= render 'layouts/flash' %>
      </div>
      <main role="main">
        <%= yield %>
        <% if Rails.env.development? %>
          <%# 投稿失敗時のデバッグの余計な文字群も考慮 %>
          <code class="debug_dump"><%= params.inspect.gsub("#<ActionController::Parameters ", "").gsub("permitted: false>", "") %></code>
        <% end %>
      </main>
      <%= render 'layouts/footer' %>
    </div>
  </body>
</html>
