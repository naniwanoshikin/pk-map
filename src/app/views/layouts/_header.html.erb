<header role="banner">
  <%# ヘッダーは常に最前面（z-index: 1050）に固定 %>
  <nav class="navbar navbar-expand-md navbar-dark bg-dark fixed-top">
    <div class="container">
      <%# タイトル %>
      <%= link_to "PK map", root_path, id: "logo", class: 'navbar-brand h-100 fw-bold ms-4' %>

      <%# 3本線から×印に変形するボタン（そのままの位置で変形） %>
      <button class="navbar-toggler custom-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar" aria-expanded="false" aria-label="Toggle navigation">
        <span class="toggler-icon top-bar"></span>
        <span class="toggler-icon middle-bar"></span>
        <span class="toggler-icon bottom-bar"></span>
      </button>

      <%# サイドバー （PCでは通常の横並びメニュー、スマホでは右スライドドロワーになる） %>
      <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasNavbar">
        <div class="offcanvas-body">
          <ul class="navbar-nav justify-content-end flex-grow-1 pe-3 align-items-md-center">
            <% if user_signed_in? %>
              <%# ========================================== %>
              <%# ログイン時 PCのみ表示されるアイコン群 %>
              <%# （d-none d-md-block でPCサイズ以上のみ表示） %>
              <%# ========================================== %>
              <%# ホーム %>
              <li class="nav-item d-none d-md-block me-3">
                <%= link_to root_path, class: "nav-link #{'active' if request.path == root_path}" do %>
                  <i class="fa fa-home fa-lg"></i>
                <% end %>
              </li>
              <%# 通知 %>
              <li class="nav-item d-none d-md-block me-3">
                <%= link_to notifications_path, class: "nav-link notice #{"active" if request.path == notifications_path}" do %>
                  <i class="far fa-bell fa-lg">
                    <%= render 'layouts/circle' %>
                  </i>
                <% end %>
              </li>
              <%# 投稿 %>
              <li class="nav-item d-none d-md-block me-3">
                <%= link_to new_post_path, class: "nav-link #{"active" if request.path == new_post_path}" do %>
                <i class="fas fa-pencil-alt fa-lg"></i>
              <% end %></li>
              <%# マイページ %>
              <li class="nav-item d-none d-md-block me-3">
                <%= link_to current_user, class: "nav-link #{"active" if request.path == user_path(current_user)}" do %>
                <i class="fas fa-user fa-lg"></i>
                <% end %>
              </li>

              <%# 歯車ドロップダウン PCのみ表示 %>
              <li class="nav-item dropdown d-none d-md-block">
                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownMenuLink" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                  <i class="fas fa-cog fa-lg"></i>
                </a>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdownMenuLink">
                  <li><%= link_to "PKmapとは", about_path, class: "dropdown-item" %></li>
                  <li><%= link_to "ユーザー一覧", users_path, class: "dropdown-item" %></li>
                  <li><%= link_to "ログアウト", logout_path, class: "dropdown-item", data: { turbo: false } %></li>
                </ul>
              </li>

              <%# スマホのみ表示 上記と重複... %>
              <li class="nav-item d-md-none"><%= link_to "PKmapとは", about_path, class: "nav-link" %></li>
              <li class="nav-item d-md-none"><%= link_to "ユーザー一覧", users_path, class: "nav-link" %></li>
              <%# 'ログアウト'が重複していてrspecで引っかかった %>
              <li class="nav-item d-md-none"><%= link_to "ログアウト", logout_path, class: "nav-link", data: { turbo: false } %></li>

            <% else %>
              <%# =================================== %>
              <%# 未ログイン時 %>
              <%# =================================== %>
              <li class="nav-item"><%= link_to "ホーム", root_path, class: 'nav-link' %></li>
              <li class="nav-item"><%= link_to "PKmapとは", about_path, class: 'nav-link' %></li>
              <li class="nav-item"><%= link_to "新規登録", new_user_registration_path, class: 'nav-link' %></li>
              <li class="nav-item"><%= link_to "ログイン", user_session_path, class: 'nav-link' %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </nav>
</header>
