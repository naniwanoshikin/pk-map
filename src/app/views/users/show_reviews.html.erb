<%# プロフィール + レビュー一覧 %>
<% provide(:title, @user.name) %>

<div class="row">

  <%= render 'profile_sidebar' %>

  <%# レビュー一覧 %>
  <div class="col-md-7">
    <div class="spot_list d-flex justify-content-around">
      <%= link_to @user do %>
        <h2>投稿一覧</h2>
      <% end %>
      <h2 class="text-dark">レビュー一覧</h2>
    </div>

    <% if @user_review_posts.any? %>
      <div id="user_posts_list" class="posts">
        <%# (posts/post) %>
        <%= render @user_review_posts %>
      </div>

      <%# ボタンエリア pagination %>
      <div id="view_more_container" class="text-center mt-4">
        <%= render 'shared/view_more_button', items: @user_review_posts %>
      </div>
    <% else %>
      <p class="text-muted text-center">まだレビューしていません</p>
    <% end %>
  </div>
</div>
