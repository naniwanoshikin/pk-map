<%# プロフィール画面 %>
<% provide(:title, @user.name) %>

<div class="row">
  <aside class="col-md-5">
    <%# ユーザー情報 %>
    <section class="mt-3">
      <%= render 'shared/user_info', user: @user %>
    </section>

    <%# 統計情報 %>
    <section class="mt-0">
      <%= render 'shared/stats', user: @user %>
    </section>

    <%# ボタン %>
    <% if current_user?(@user) %>
      <%# プロフィール編集 %>
      <section class="profile_edit">
        <%= link_to "プロフィール編集", edit_user_registration_path, class: "btn btn-outline-secondary w-100" %>
      </section>
    <% else %>
      <%# [follow] ボタン %>
      <section class="profile_follow">
        <%= render 'follow_form', user: @user if user_signed_in? %>
      </section>
    <% end %>
  </aside>

  <%# 投稿一覧 & pagination %>
  <div class="col-md-7">
    <div id="users_show">
      <%= render 'users/show_posts' %>
    </div>
  </div>
</div>
