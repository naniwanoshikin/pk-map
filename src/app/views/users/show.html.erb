<%# プロフィール + 投稿一覧 %>
<% provide(:title, @user.name) %>

<div class="row">

  <%= render 'profile_sidebar' %>

  <%# 投稿一覧 %>
  <div class="col-md-7">
    <div class="spot_list d-flex justify-content-around">
      <h2 class="text-dark">投稿一覧</h2>
      <% if @user.reviews.any? %>
        <%= link_to show_reviews_user_path(@user) do %>
          <h2>レビュー一覧</h2>
        <% end %>
      <% end %>
    </div>
    <%# SQL減らす %>
    <% if @posts.present? %>
      <div id="user_posts_list" class="posts">
        <%# (posts/post) %>
        <%= render @posts %>
      </div>

      <%# ボタンエリア pagination %>
      <div id="view_more_container" class="text-center mt-4 mb-4">
        <%= render 'shared/view_more_button', items: @posts %>
      </div>
    <% else %>
      <p class="text-muted text-center">まだ投稿していません</p>
    <% end %>
  </div>
</div>
