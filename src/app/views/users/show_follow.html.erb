<%# フォロー一覧 @共用 (C) %>
<% provide(:title, @title) %>

<div class="row">
  <aside class="col-md-5">

    <section class="mt-3">
      <%= render 'shared/user_info', user: @user %>
    </section>

    <%# 統計情報 %>
    <section class="mt-0">
      <%= render 'shared/stats', user: @user %>
    </section>

    <%# アイコン一覧 %>
    <% if @users.any? %>
      <div class="d-flex flex-wrap align-items-center mt-2 mb-2  ms-1">
        <% @users.each do |user| %>
          <%= link_to gravatar_for(user, size: 30), user %>
        <% end %>

        <%# 総件数が表示件数(Users(C)_per())より多い場合 %>
        <% if @users.total_count > @users.limit_value %>
          <span class="text-muted small ms-1" title="他 <%= @users.total_count - @users.limit_value %> 人">ほか</span>
        <% end %>

      </div>
    <% end %>
  </aside>

  <div class="col-md-7">
    <h2 class="mt-3 mb-3"><%= @title %></h2>
    <% if @users.any? %>
      <ul id="users_list" class="ps-2">
        <%= render @users %>
      </ul>

      <%# ボタンエリア pagination %>
      <div id="view_more_container" class="text-center mt-4">
        <%= render 'shared/view_more_button', items: @users %>
      </div>
    <% else %>
      <p class="text-muted text-center">ユーザーはまだいません</p>
    <% end %>
  </div>
</div>
