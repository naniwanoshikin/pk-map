<%# フォロー一覧 %>
<% provide(:title, @title) %>

<div class="row">
  <aside class="col-md-5">

    <section class="mt-3">
      <%= render 'shared/user_info', user: @user %>
    </section>

    <%# 統計情報 %>
    <section class="mt-0">
      <%= render 'shared/stats', user: @user %>
    </section>

    <%# アイコン一覧 %>
    <% if @users.any? %>
      <div class="user_avatars">
        <% @users.each do |user| %>
          <%= link_to gravatar_for(user, size: 30), user %>
        <% end %>
      </div>
    <% end %>
  </aside>

  <div class="col-md-7">
    <h2 class="mt-2 mb-3"><%= @title %></h2>
    <% if @users.any? %>
      <div id="users_follow">
        <ul class="ps-2">
          <%= render @users %>
        </ul>
        <%= paginate @users %>
      </div>
    <% else %>
      <p class="text-muted text-center">ユーザーはまだいません</p>
    <% end %>
  </div>
</div>
