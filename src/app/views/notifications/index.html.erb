<% provide(:title, '通知') %>

<h2>通知</h2>

<div class="container">
  <div class="row">
    <div class="col-md-9 mx-auto">
      <% if @notifications.any? %>
        <ul id="notifications_list">
          <%= render @notifications %>
        </ul>

        <%# もっと見るボタン %>
        <div id="view_more_container" class="text-center mt-4 mb-4">
          <%= render 'shared/view_more_button', items: @notifications %>
        </div>

      <% else %>
        <p class="text-muted text-center">通知はまだありません</p>
      <% end %>
    </div>
  </div>
</div>
