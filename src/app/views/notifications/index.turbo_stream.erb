<%# ul（#notify_lists）の末尾に、新しい通知 li を追加 %>
<%= turbo_stream.append "notify_lists" do %>
  <%= render @notifications %>
<% end %>

<%# ボタンエリアを、次のページのボタンで置換 %>
<%= turbo_stream.replace "view_more_container" do %>
  <div id="view_more_container" class="text-center mt-4">
    <%= render 'view_more_button', notifications: @notifications %>
  </div>
<% end %>
