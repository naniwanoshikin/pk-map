<% visitor = notification.visitor %>
<%# notifications_helper_3つ %>

<li class="d-flex align-items-start gap-2 mb-1">
  <%# 1. マーク %>
  <div class="action_mark me-2">
    <i class="<%= notification_icon_class(notification.action) %> fa-lg"></i>
  </div>

  <%# 2. アバターアイコン %>
  <%= link_to gravatar_for(visitor, size: 30), visitor %>

  <%# 3. 通知文コンテンツ %>
  <div class="flex-grow-1">
    <strong><%= link_to visitor.name, visitor %></strong>

    <span class="text-black">さん<%= notification_action_text(notification.action) %></span>

    <% if notification.review.present? %>
      <p class="notify_quote mb-0">
        <%= link_to notification.review.content, notification_target_post(notification) %>
      </p>
    <% end %>
  </div>

  <%# 4. タイムスタンプ（右寄せ） %>
  <div class="small text-muted text-nowrap me-2">
    <%= time_ago_in_words(notification.created_at).upcase %>前
  </div>
</li>
