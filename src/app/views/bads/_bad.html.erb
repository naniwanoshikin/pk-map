<%# (reviews/_review) %>
<%# User(M) %>
<% if current_user&.bad?(review) %>
  <%# 低評価している場合 (解除ボタン) SQLゼロ %>
  <%= link_to bad_path(review.bads.find {|bad| bad.user_id == current_user.id}),
        data: { turbo_method: :delete },
        class: '' do %>
    <i class="fas fa-thumbs-down fa-lg"></i>
  <% end %>

<% else %>
  <%# 低評価していない場合 %>
  <%= link_to bads_path(review: review),
        data: { turbo_method: :post },
        class: '' do %>
    <i class="far fa-thumbs-down fa-lg"></i>
  <% end %>
<% end %>

<%# 低評価数（自身のレビューなら表示） %>
<% if review.user_id == current_user&.id && review.bads.any? %>
  <span class="ev_count">
    <%= review.bads.size %>
  </span>
<% end %>
