<%# 地図のピン情報を更新 Stimulus %>
<%= turbo_stream.update "map_feeds_updater" do %>
  <div data-action="turbo:morph->map-home#updateFeeds"
       data-feeds="<%= @feed_items ? @feed_items.to_json : '[]' %>"></div>
<% end%>

<%# 右下のタイムラインフィード一覧を最新の検索結果に丸ごと置換 %>
<%= turbo_stream.replace "timeline_feed" do %>
  <div id="timeline_feed">
    <%= render 'shared/feed' %>
  </div>
<% end %>
