<%# 投稿単体 (shared/_feed), (users/_show_posts) 引数: post %>

<div id="<%= dom_id(post) %>">
  <header id="<%= dom_id(post, :header) %>">
    <h5 class="m-0 text-truncate" title="<%= post.address %>"><%= post.address %></h5>
  </header>

  <main>
    <%= link_to post, class: "link", data: { turbo_frame: "_top" } do %>
      <%# 評価 %>
      <div class="average_score d-flex align-items-center mt-1">
        <%# ★★☆☆☆ %>
        <div class="star_rating me-1">
          <div class="star_back">★★★★★</div>
          <div class="star_front" style="width: <%= post.review_score_percentage %>%;">★★★★★</div>
        </div>
        <%# 平均点 %>
        <div class="small text-muted">
          <span class="text-dark"><%= post.avg_score %></span>
          <span>(<%= post.reviews.size %>)</span>
        </div>
      </div>

      <%# 画像 遅延読み込み posts_helper %>
      <%= image_tag streetview_image_ulr(post), alt: post.address, loading: "lazy" %>

      <%# 文章 %>
      <div class="content text-truncate"><%= post.content %></div>
    <% end %>
  </main>

  <footer class="card-footer p-1 bg-white">
      <%# 画像 %>
    <div><%= link_to gravatar_for(post.user, size: 30), post.user, data: { turbo_frame: "_top" } %></div>
    <%# 3分前 %>
    <div class="timestamp ms-auto">
      <%= time_ago_in_words(post.created_at) %>前
    </div>
  </footer>
</div>
