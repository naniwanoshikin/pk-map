<% provide(:title, "スポット投稿") %>
<h2>どんなスポット？</h2>

<div class="container">
  <div class="row">
    <div class="col-md-9 mx-auto">
      <%# 投稿フォーム %>
      <section>
        <%= form_with(model: @post, data: { turbo: false }) do |f| %>
          <%# <%= render 'shared/error_messages', object: @post %>

          <%# 1. テキストフィールド %>
          <div class="mb-3">
            <%# application_helper %>
            <%= f.label :address, 'スポット名', class: form_label_class(@post, :address) %>
            <small class="text-danger">＊必須</small>
            <%= f.text_field :address, placeholder: "例: 鶴見緑地", autocomplete: "off",
            class: form_control_class(@post, :address) %>
          </div>

          <%# 2. ラジオボタン %>
          <div class="mb-3">
            <div>
              <%= f.label :spot_quality, 'スポットの質', class: form_label_class(@post, :spot_quality) %>
              <small class="text-danger">＊必須</small>
            </div>
            <% %w(良い 普通 悪い).each do |quality| %>
              <div class="form-check form-check-inline">
                <%= f.radio_button :spot_quality, quality, class: "form-check-input" %>
                <%= f.label :spot_quality, quality, value: quality, class: "form-check-label" %>
              </div>
            <% end %>
          </div>

          <%# 3. チェックボックス %>
          <div class="mb-3">
            <%= f.label :spot_type, 'タイプ', class: "fw-bold form-label d-block" %>
            <% %w(公園 スロープ 鉄棒).each do |spot| %>
              <div class="form-check form-check-inline">
                <%= f.check_box :spot_type, { multiple: true, class: "form-check-input" }, spot, false %>
                <%= f.label :spot_type, spot, value: spot, class: "form-check-label" %>
              </div>
            <% end %>
          </div>

          <%# 4. テキストエリア %>
          <div class="mb-3">
            <%= f.label :content, 'スポット詳細', class: "fw-bold form-label" %>
            <%= f.text_area :content, placeholder: "鉄棒がきれい", class: "form-control" %>
          </div>

          <div class="mt-4">
            <%= f.submit "投稿", class: "btn btn-primary w-100" %>
          </div>
        <% end %>
      </section>
    </div>
  </div>
</div>
