- provide(:title, "Spot_Post")
h2 どんなスポット？

.container
  .row
    .col-md-9.mx-auto
      / 投稿フォーム
      section.post_form
        = form_with(model: @post, local: true) do |f|
          / = render 'shared/error_messages', object: @post

          / 1. スポット名（テキストフィールド）
          .form-group.mb-3
            = f.label :address, 'スポット名', class: "form-label #{@post.errors[:address].any? ? 'fw-bolder text-danger' : 'fw-bold'}"
            small.text-danger.fw-normal ＊必須
            br
            = f.text_field :address, placeholder: "鶴見緑地", class: "form-control #{@post.errors[:address].any? ? 'is-invalid' : ''}"

          / 2. スポットの質（ラジオボタン）
          .form-group.mb-3
            = f.label :spot_quality, 'スポットの質', class: "form-label #{@post.errors[:spot_quality].any? ? 'fw-bolder text-danger' : 'fw-bold'}"
            small.text-danger.fw-normal ＊必須
            br
            - %w(良い 普通 悪い).each do |spot|
              = f.radio_button :spot_quality, spot
              = f.label :spot_quality, spot, value: spot, class: "form-check-label me-2"

          / 3. タイプ（チェックボックス）
          .form-group.mb-3
            = f.label :spot_type, 'タイプ'
            br
            - %w(公園 スロープ 鉄棒).each do |spot|
              = f.check_box :spot_type, {multiple: true}, spot, false
              = f.label :spot_type, spot, value: spot

          / 4. スポット詳細（テキストエリア）
          .form-group.mb-3
            = f.label :content, 'スポット詳細'
            = f.text_area :content, placeholder: "鉄棒がきれい", class: "form-control"

          .form-group.mt-3.text-center
            = f.submit "投稿", class: "btn btn-primary w-100"
