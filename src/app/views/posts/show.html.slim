/ 投稿詳細 Posts(C)
h2 = @post.address

.container
  .row
    .col-md-9.col-md-offset-2.mx-auto.px-0.posts_show
      / 投稿ユーザー
      .user_post.mb-1
        = link_to @post.user.name, @post.user
        / 投稿削除
        .float-right
          - if current_user?(@post.user)
            = link_to @post, class: "text-danger", method: :delete, data: { confirm: "You sure?" } do
              i.fas.fa-trash-alt.fa-lg

      / 地図
      #detail_map

      .post_state.pl-4.my-4
        / 戻る
        = link_to 'javascript:history.back()' do
          i.fas.fa-long-arrow-alt-left.fa-lg
        / 情報
        .ml-4
          .text-muted = @post.content
          / Post(M)
          .text-muted.mt-2
            | 場所:
            = @post.munic
          /
          - if @post.spot_quality.present?
            .text-muted.mt-2
              | 芝生:
              = @post.spot_quality

        / Twitter
        .ml-5
          - twitter_url = "http://twitter.com/share?text=#{u(@post.address)} の口コミ&hashtags=パルクール,pkmap&url=#{u(request.original_url)}&via=power_of_shikin"
          = link_to twitter_url, title: 'Twitter', target: '_blank', rel: 'noopener' do
            i.fab.fa-twitter.fa-lg


      .show_reviews.mb-4
        h2.text-left.mb-3.pl-2 レビューを投稿しましょう
        / レビューフォーム
        - if user_signed_in?
          = render "reviews/form", review: @review

      / レビュー一覧 destroy_ajax
      #reviews
        = render @review
        / (reviews/_review) @reviewsだと複製

/ Google Maps APIのスクリプト読み込み
- google_api = "https://maps.googleapis.com/maps/api/js?key=#{ ENV['GOOGLE_MAP_API'] }&callback=initMap&libraries=marker".html_safe

script(async=true defer=true src=google_api)

javascript:

  let show_map;

  function initMap() {
    const target = document.getElementById('detail_map')
    if (!target) return;

    // Rubyの変数から直接数値を取得し、nilの場合は0（またはデフォルト値）
    const lat = parseFloat(#{@post.latitude || 0});
    const lng = parseFloat(#{@post.longitude || 0});
    const content = "#{j @post.content}";

    // もし座標が取れていなければデバッグ
    if (lat === 0 && lng === 0) {
      console.warn("警告: 投稿の座標（緯度・経度）が取得できていません。");
    }

    show_map = new google.maps.Map(target, {
      center: { lat: lat, lng: lng },
      zoom: 15,
      mapTypeControl: false, // 地図|航空写真
      mapId: 'DEMO_MAP_ID' // AdvancedMarker に必須の記述
    });

    const marker = new google.maps.marker.AdvancedMarkerElement({
      position: { lat: lat, lng: lng },
      map: show_map,
      title: content
    });
    // 吹き出し
    const infowindow = new google.maps.InfoWindow();
    marker.addEventListener('gmp-click', function() {
      infowindow.setContent(
        // 画像
        '<div class="infowindow">'
        + `<span class="">${content}</span>`
        + `<img src='https://maps.googleapis.com/maps/api/streetview?size=640x480&heading=160&fov=120&location=${lat},${lng}&key=#{ ENV['GOOGLE_MAP_API'] }' >`
        + '</div>'
      );
      infowindow.open(show_map, marker);
    });
  }

  // ページを戻った時にもしっかり再描画させる
  document.addEventListener('turbolinks:load', initMap);
