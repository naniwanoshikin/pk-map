/ 投稿詳細 Posts(C)
h2 = @post.address

.container
  .row
    .col-md-9.col-md-offset-2.mx-auto.px-0.posts_show
      / 投稿ユーザー
      .user_post.mb-1
        = link_to @post.user.name, @post.user
        / 投稿削除
        .float-right
          - if current_user?(@post.user)
            = link_to @post, class: "text-danger", method: :delete, data: { confirm: "You sure?" } do
              i.fas.fa-trash-alt.fa-lg

      / 地図 railsのデータ属性 -> (datail_map.js)
      #detail_map[
        data-lat="#{@post.latitude}"
        data-lng="#{@post.longitude}"
        data-content="#{j @post.content}"
        data-api-key="#{ENV['GOOGLE_MAP_API']}"
      ]

      .post_state.pl-4.my-4
        / 戻る
        = link_to 'javascript:history.back()' do
          i.fas.fa-long-arrow-alt-left.fa-lg
        / 情報
        .ml-4
          .text-muted = @post.content
          / Post(M)
          .text-muted.mt-2
            | 場所:
            = @post.munic
          /
          - if @post.spot_quality.present?
            .text-muted.mt-2
              | 芝生:
              = @post.spot_quality

        / Twitter
        .ml-5
          - twitter_url = "http://twitter.com/share?text=#{u(@post.address)} の口コミ&hashtags=パルクール,pkmap&url=#{u(request.original_url)}&via=power_of_shikin"
          = link_to twitter_url, title: 'Twitter', target: '_blank', rel: 'noopener' do
            i.fab.fa-twitter.fa-lg


      .show_reviews.mb-4
        h2.text-left.mb-3.pl-2 レビューをしよう
        / レビューフォーム
        - if user_signed_in?
          = render "reviews/form", review: @review

      / レビュー一覧 destroy_ajax
      #reviews
        = render @review
        / (reviews/_review) @reviewsだと複製

/ Google Maps APIのスクリプト読み込み
- google_api = "https://maps.googleapis.com/maps/api/js?key=#{ ENV['GOOGLE_MAP_API'] }\u0026callback=initMap&libraries=marker&loading=async".html_safe

script src=google_api defer=true
