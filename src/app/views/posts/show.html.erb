<%# 投稿詳細 Posts(C) %>
<h2><%= @post.address %></h2>

<div class="container">
  <div class="row">
    <div class="col-md-9 col-md-offset-2 mx-auto px-0 posts_show">
      <%# 投稿ユーザー %>
      <div class="user_post mb-1">
        <%= link_to @post.user do %>
          <%= @post.user.name %>
        <% end %>
      </div>

      <!-- 投稿削除 -->
      <div class="float-right">
        <% if current_user?(@post.user) %>
          <%= link_to @post, class: "text-danger", method: :delete, data: { confirm: "You sure?" } do %>
            <i class="fas fa-trash-alt fa-lg"></i>
          <% end %>
        <% end %>
      </div>

      <%# 地図 railsのデータ属性 -> (datail_map.js) %>
      <div id="detail_map"
        data-lat="<%= @post.latitude %>"
        data-lng="<%= @post.longitude %>"
        data-content="<%= j @post.content %>"
        data-api-key="<%= ENV['GOOGLE_MAP_API'] %>"
      ></div>

      <div class="post_state pl-4 my-4">
        <%# 戻る %>
        <%= link_to "javascript:history.back()" do %>
          <i class="fas fa-long-arrow-alt-left fa-lg"></i>
        <% end %>

        <%# 情報 %>
        <div class="ml-4">
          <div class="text-muted">
            <%= @post.content %>
          </div>

          <div class="text-muted mt-2">
          <%# Post(M) %>
            場所：<%= @post.munic %>
          </div>

          <% if @post.spot_quality.present? %>
            <div class="text-muted mt-2">
              芝生：<%= @post.spot_quality %>
            </div>
          <% end %>
        </div>

        <%# Twitter %>
        <div class="ml-5">
          <%
            twitter_url = "http://twitter.com/share?text=#{u(@post.address)} について &hashtags=パルクール,pkmap&url=#{u(request.original_url)}&via=power_of_shikin"
          %>
          <%= link_to twitter_url, title: "Twitter", target: "_blank", rel: "noopener" do %>
            <i class="fab fa-twitter fa-lg"></i>
          <% end %>
        </div>
      </div>

      <div class="show_reviews mb-4">
        <h2 class="text-left mb-3 pl-2">レビューをしよう</h2>
        <%# レビューフォーム %>
        <% if user_signed_in? %>
          <%= render "reviews/form", review: @review %>
        <% end %>

        <%# レビュー一覧 destroy_ajax %>
        <div id="reviews">
          <%# (reviews/_review) ⬇︎@reviewsだと複製される %>
          <%= render @review %>
        </div>
      </div>
    </div>
  </div>
</div>

<%# Google Maps APIのスクリプト読み込み %>
<%
  google_api = "https://maps.googleapis.com/maps/api/js?key=#{ ENV['GOOGLE_MAP_API'] }\u0026callback=initMap&libraries=marker&loading=async".html_safe
%>
<script src="<%= google_api %>" defer="true"></script>
