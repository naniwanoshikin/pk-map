<%# 投稿詳細 Posts(C) %>
<h2><%= @post.address %></h2>

<div class="container">
  <div class="row">
    <div class="col-md-9 mx-auto px-0 posts_show">

      <div class="d-flex justify-content-between align-items-center mb-1">
        <%# 投稿ユーザー %>
        <div class="user_post">
          <%= link_to @post.user.name, @post.user %>
        </div>
        <!-- 投稿削除 -->
        <% if current_user?(@post.user) %>
          <div class="">
              <%= link_to @post, class: "text-danger", data: { turbo_method: :delete, turbo_confirm: "投稿を削除しますか？" } do %>
                <i class="fas fa-trash-alt fa-lg"></i>
              <% end %>
          </div>
        <% end %>
      </div>

      <%# 地図 (map_show_controller.js) %>
      <div id="map_show"
        data-controller="map-show"
        data-map-show-lat-value="<%= @post.latitude %>"
        data-map-show-lng-value="<%= @post.longitude %>"
        data-map-show-content-value="<%= @post.content %>"
        data-map-show-api-key-value="<%= ENV['GOOGLE_MAP_API'] %>"
      ></div>

      <div class="post_state pl-4 my-4">
        <%# 戻る %>
        <%= link_to :back do %>
          <i class="fas fa-long-arrow-alt-left fa-lg"></i>
        <% end %>

        <%# 情報 %>
        <div class="ml-4">
          <div class="text-muted">
            <%= @post.content %>
          </div>

          <div class="text-muted mt-2">
          <%# Post(M) %>
            場所：<%= @post.munic %>
          </div>

          <% if @post.spot_quality.present? %>
            <div class="text-muted mt-2">
              芝生：<%= @post.spot_quality %>
            </div>
          <% end %>
        </div>

        <div class="ml-5">
          <%
            twitter_url = "http://twitter.com/share?text=#{u(@post.address)} について &hashtags=パルクール,pkmap&url=#{u(request.original_url)}&via=power_of_shikin"
          %>
          <%= link_to twitter_url, title: "Twitter", target: "_blank", rel: "noopener" do %>
            <i class="fab fa-twitter fa-lg"></i>
          <% end %>
        </div>
      </div>

      <div class="show_reviews mb-4">
        <h2 class="text-left mb-3 pl-2">レビューをしよう</h2>
        <%# レビューフォーム %>
        <% if user_signed_in? %>
          <%= render "reviews/form", review: @review %>
        <% end %>

        <div id="reviews">
          <% if @reviews.any? %>
            <%# レビュー一覧 destroy_ajax %>
            <ul id="reviews_list">
            <%# (reviews/_review) %>
              <%= render @reviews %>
            </ul>
          <% else %>
            <h2 class="text-center">
              レビューがまだありません
            </h2>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
