<%# 投稿詳細 Posts(C) %>
<h2><%= @post.address %></h2>

<div class="container">
  <div class="row">
    <div class="col-md-9 mx-auto px-0 posts_show">

      <div class="d-flex justify-content-between align-items-center mb-1">
        <%# 投稿ユーザー %>
        <%= link_to @post.user.name, @post.user, class: "text-reset text-decoration-none" %>
        <!-- 投稿削除 -->
        <% if current_user?(@post.user) %>
          <%= button_to @post,
            method: :delete,
            form: {class: "d-inline", data: { turbo: false}},
            onclick: "return confirm('投稿を削除しますか？')",
            class: "btn btn-link p-0 border-0 text-danger" do %>
            <i class="fas fa-trash-alt fa-lg"></i>
          <% end %>
        <% end %>
      </div>

      <%# 地図 (map_show_controller.js) %>
      <div id="map_show" class="mx-auto rounded mb-2"
        data-controller="map-show"
        data-map-show-lat-value="<%= @post.latitude %>"
        data-map-show-lng-value="<%= @post.longitude %>"
        data-map-show-content-value="<%= @post.content %>"
        data-map-show-api-key-value="<%= ENV['GOOGLE_MAP_API'] %>"
      ></div>

      <div class="d-flex align-items-center gap-4 ps-2 my-4">
        <%# 戻る %>
        <%= link_to :back do %>
          <i class="fas fa-long-arrow-alt-left fa-lg"></i>
        <% end %>

        <%# 情報 %>
        <div class="text-muted flex-grow-1">
          <%= simple_format @post.content, {}, wrapper_tag: :span %>
          <%# Post(M) %>
          <div class=" mt-2">場所：<%= @post.munic %></div>
          <% if @post.spot_quality.present? %>
            <div class=" mt-2">芝生：<%= @post.spot_quality %></div>
          <% end %>
        </div>

        <div class="mx-2">
          <%# helper %>
          <%= link_to post_share_url(@post), title: "Twitter", target: "_blank", rel: "noopener" do %>
            <i class="fab fa-twitter fa-lg"></i>
          <% end %>
        </div>
      </div>

      <div class="show_reviews mb-4">
        <h2 class="mb-3">レビューをしよう</h2>
        <%# ⭐︎⭐︎⭐︎⭐︎⭐︎ %>
        <%= render "reviews/form", review: @review if user_signed_in? %>

        <%# レビュー一覧 %>
        <div id="reviews">
          <ul id="reviews_list" class="list-unstyled px-2 mx-auto"><%= render @reviews %></ul>
          <%# (reviews/_review, reviews.scss_条件分岐) %>
          <h2 class="text-center empty-reviews-message">レビューがまだありません</h2>
        </div>
      </div>
    </div>
  </div>
</div>
