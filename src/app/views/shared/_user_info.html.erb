<%# (users/show, show_follow, show_reviews) %>
<div class="d-flex align-items-center">
  <%= link_to gravatar_for(user, size: 50), user, class: "me-3 mr-2" %>
  <div>
    <h1 class="h5 mb-1 font-weight-bold fw-bold">
      <%= link_to user.name, user, class: "text-dark text-decoration-none" %>
    </h1>
    <p class="text-muted small mb-0">
      <%= user.address %> 勢
    </p>
  </div>
</div>
