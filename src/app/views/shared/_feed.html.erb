<%# (home_pages/home_login) %>

<% if @feed_items.any? %>
  <%# 非同期処理 = Fetch API %>
  <%= turbo_frame_tag "home_feed" do %>
    <div class="posts">
      <%= render @feed_items %>
      <%# (posts/_post) %>
    </div>
    <%= paginate @feed_items,
      params: { controller: :home_pages, action: :home }
    %>
  <% end %>
<% else %>
  <h2 class="mt-5">あなたの知るスポット情報を投稿したり、<br>ユーザーをフォローしましょう</h2>
  <div class="text-center">
    <p><%= link_to "投稿する", new_post_path %></p>
    <p><%= link_to "ユーザーを探す", users_path %></p>
  </div>
<% end %>
