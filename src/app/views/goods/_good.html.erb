<%# (reviews/_review) %>
<%# User(M) %>
<% if current_user&.good?(review) %>
  <%# 高評価している場合 (Good 解除ボタン) SQLゼロ %>
  <%= link_to good_path(review.goods.find { |good| good.user_id == current_user.id }),
        data: { turbo_method: :delete },
        class: '' do %>
    <i class="fas fa-thumbs-up fa-lg"></i>
  <% end %>

<% else %>
  <%# 高評価していない場合 %>
  <%= link_to goods_path(review: review),
        data: { turbo_method: :post },
        class: '' do %>
    <i class="far fa-thumbs-up fa-lg"></i>
  <% end %>
<% end %>

<%# 高評価数があれば %>
<% if review.goods.any? %>
  <span class="ev_count">
    <%# (reviews/good_users) 高評価したユーザー一覧 %>
    <%= link_to good_users_review_path(review), class: "text-muted" do %>
      <%= review.goods.size %>
    <% end %>
  </span>
<% end %>
