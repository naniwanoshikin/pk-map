<%# (reviews/_review) %>

<% if current_user&.good?(review) %>
  <%# 高評価している場合 (Good 解除ボタン) %>
  <%= link_to good_path(current_user.goods.find_by(review: review)),
        data: { turbo_method: :delete },
        class: 'link' do %>
    <i class="fas fa-thumbs-up fa-lg"></i>
  <% end %>

<% else %>
  <%# 高評価していない場合 %>
  <%= link_to goods_path(review: review),
        data: { turbo_method: :post },
        class: 'link' do %>
    <i class="far fa-thumbs-up fa-lg"></i>
  <% end %>
<% end %>

<%# 高評価数 %>
<% if review.goods.present? %>
  <span class="ev_count">
    <%# (reviews/good_users) 高評価したユーザー一覧 %>
    <%= link_to good_users_review_path(review) do %>
      <%= review.goods.size %>
    <% end %>
  </span>
<% end %>
