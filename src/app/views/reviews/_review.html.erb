<%# レビュー (posts/show) %>
<% reviewer = review.user %>

<%# TurboStream ▶︎ dom_ID %>
<li id="<%= dom_id(review) %>">
  <div class="d-flex justify-content-between align-items-start">
    <div class="review_user d-flex align-items-center gap-2">
      <%# 画像 %>
      <%= link_to gravatar_for(reviewer, size: 30), reviewer %>
      <div class="lh-sm">
        <%# 鈴木 口コミ10件 %>
        <strong><%= link_to reviewer.name, reviewer %></strong>
        <div class="review_number small text-muted">
          <%= link_to show_reviews_user_path(reviewer) do %>
            口コミ<%= reviewer.reviews_count %>件
          <% end %>
        </div>
      </div>
    </div>

    <%# 削除ボタン review_id: (C)_private %>
    <% if current_user?(reviewer) %>
      <%= link_to post_reviews_path(post_id: review.post, review_id: review.id), class: "text-danger", data: { turbo_method: :delete, turbo_confirm: "レビューを削除しますか?" } do %>
        <i class="fas fa-trash-alt"></i>
      <% end %>
    <% end %>
  </div>

  <%# ★★☆☆☆ + 4日前 %>
  <div class="mt-1">
    <%= link_to review, class: 'd-inline-flex align-items-center gap-2 text-decoration-none' do %>
      <%# ★★☆☆☆ %>
      <div class="star_rating">
        <div class="star_back">★★★★★</div>
        <div class="star_front" style="width: <%= (review.score.to_f * 20).to_i %>%;">★★★★★</div>
      </div>
      <%# 4日前 %>
      <span class="small text-muted">
        <%= time_ago_in_words(review.created_at).upcase %>前
      </span>
    <% end %>
  </div>

  <%# レビュー 改行あり %>
  <div class="mt-2 ms-1">
    <%= simple_format(review.content, class: "m-0 text-dark") %>
  </div>

  <div class="d-flex gap-3 mt-2 mb-1 ms-5">
    <%# Goodボタン %>
    <div id="good-<%= review.id %>" class="ev_btn">
      <%= render "goods/good", review: review %>
    </div>
    <%# Badボタン %>
    <div id="bad-<%= review.id %>" class="ev_btn">
      <%= render "bads/bad", review: review %>
    </div>
  </div>
</li>
