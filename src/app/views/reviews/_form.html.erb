<%# (posts/show) %>
<%# stimulus (star_review.js) 全体を囲む %>
<div data-controller="star-review">

  <%# モーダル開く前 %>
  <div id="openModalBtn" class="btn_ratings d-flex justify-content-between py-2" tabindex="0">
    <%# ⭐︎⭐︎⭐︎⭐︎⭐︎ (モーダル起動トリガーを付与 ▶︎ クリックした星の数がモーダル内に引継ぎ) %>
    <% (1..5).each do |i| %>
      <span class="star_trigger far fa-star fa-2x"
            data-score="<%= i %>"
            data-toggle="modal"
            data-target="#exampleModal"
            <%# stimulus用 追記 %>
            data-star-review-target="triggerStar"
            data-action="click->star-review#selectFromOutside">
      </span>
    <% end %>
  </div>

  <%# モーダル画面 開いた後 %>
  <div id="exampleModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 id="exampleModalLabel" class="modal-title">
            <%= @post.address %>
          </h5>

          <button class="close" type="button" data-dismiss="modal" aria-label="Close">
            <%# × %>
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <div id="modal_errors">
            <% if user_signed_in? && defined?(review) && review.errors.any? %>
              <%= render 'shared/error_messages', object: review %>
            <% end %>
          </div>
          <%# Turbo %>
          <div class="rating-box">
            <%= form_with model: review, url: post_reviews_path(@post) do |f| %>
              <div class="form-group main-rating">
                <div class="ratings mr-2">
                  <%# ⭐︎⭐︎⭐︎⭐︎⭐︎ くり抜き状態 %>
                  <% (1..5).each do |i| %>
                    <span class="star far fa-star"
                          data-value="<%= i %>"
                          <%# stimulus用に追記 %>
                          data-star-review-target="modalStar"
                          data-action="mouseover->star-review#hover mouseout->star-review#reset click->star-review#selectInside">
                    </span>
                  <% end %>
                </div>
                <div class="rating_value_display">
                  <span id="rating_value">0</span>/5
                </div>
              </div>
              <%# → Reviews(C) post_id に入る %>
              <%= f.hidden_field :post_id, value: @post.id %>

              <%# 星の個数 js %>
              <%= f.hidden_field :score, id: "hidden_score" %>

              <div class="form-group">
                <%= f.text_area :content, id: "review_content_textarea", placeholder: "動きやすかった", class: "form-control" %>
              </div>

              <div class="modal-footer">
                <button class="btn btn-secondary" type="button" id="submitReviewBtn" data-dismiss="modal">
                  閉じる
                </button>
                <%= f.submit "投稿", class: "btn btn-primary" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
