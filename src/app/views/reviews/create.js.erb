<%# (posts/show) %>

<%# 投稿失敗 = バリデーションエラーあり %>
<% if @review.errors.any? %>
  <%# 出てきたエラー表示の箱を一旦空(empty)にしてから、エラー文を中に追加(append)。つまりエラーの箱が消滅することなく差し替える / モーダルは閉じない %>
  $("#modal_errors").empty().append("<%= escape_javascript(render 'shared/error_messages', object: @review) %>");

<% else %>
  <%# 投稿成功時 %>
  <%# 直前の失敗で出たエラーが、成功後モーダルを開いたとき残っていない様、エラーの箱の中身だけを空にする %>
  $("#modal_errors").empty();

  <%# レビュー一覧(posts/show)を更新 %>
  $("#reviews").html("<%= escape_javascript(render 'reviews/review', reviews: @reviews) %>");

  <%# (reviews/form)_モーダル %>
  $("textarea").val("");

  <%# 星の見た目: 未選択状態にリセット %>
  $(".fa-star").removeClass("fas").addClass("far");
  <%# 星の値: 評価0 %>
  $("#rating_value").text("0");
  <%# 隠しフォームの値(前回送信用の星の値)も残らない様、空(0)にリセット %>
  $("#hidden_score").val("");

  <%# モーダル画面を閉じる Bootstrapのお片付け命令 %>
  $('#exampleModal').modal('hide');

  <%# フラッシュメッセージ %>
  $("#flash_messages").html("<%= escape_javascript(render 'layouts/flash', reviews: @reviews) %>");
  <%# (flash.js) 再実行し、(#flash_messages)を更新 %>
  if (typeof window.refreshFlashBehavior === 'function') {
  <%# console.log('reviews/create.js.erbよりflash') %>
    window.refreshFlashBehavior();
  }

<% end %>