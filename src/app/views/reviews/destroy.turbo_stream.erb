<%# (posts/show)_レビューを削除 %>

<%# 1. レビュー一覧エリア %>
<%# レビューが1件以上残っているか？ %>
<% if @reviews.any? %>
  <%# 削除した1件のliだけをDOMから消す %>
  <%= turbo_stream.remove @review %>
<% else %>
  <%# 最後の1件を削除した場合 %>
  <%= turbo_stream.update "reviews" do %>
    <h2 class="text-center">
      レビューがまだありません
    </h2>
  <% end %>
<% end %>


<%# 2. フラッシュメッセージエリアを更新 %>
<%= turbo_stream.update "flash_messages" do %>
  <%= render 'layouts/flash' %>
  <%# Stimulus (flash_behavior_controller.js) %>
  <div data-controller="flash-behavior"></div>
<% end %>
